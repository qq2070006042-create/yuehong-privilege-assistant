<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required to enumerate installed KernelSU manager variants for the selector. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Required to request notification permission on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <receiver
            android:name=".shell.KernelSuManagerUpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
        <provider
            android:name=".shell.GhostLockOtaProvider"
            android:authorities="${applicationId}.ghostlock.ota"
            android:exported="false" />
        <activity
            android:name=".dfroot.DirtyFragVrActivity"
            android:exported="false"
            android:label="@string/dirtyfrag_vr_title"
            android:theme="@style/Theme.Stellar" />
    </application>

</manifest>
